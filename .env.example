# Database Connection String
# PostgreSQL Production:
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/omnichannel_db
# Local SQLite Zero-Config Runtime:
DATABASE_URL=sqlite:///./omnichannel.db

# Deterministic Seed
DEFAULT_SEED=20261022

# System Scoring Weights
WEIGHT_SKILL=0.35
WEIGHT_LANGUAGE=0.25
WEIGHT_CAPACITY=0.25
WEIGHT_EXPERIENCE=0.15

# Business Calendar
BUSINESS_START_HOUR=9
BUSINESS_END_HOUR=18
BUSINESS_TIMEZONE=Asia/Kolkata

# Security & Authentication
SECRET_KEY=omniroute-enterprise-secure-jwt-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=480
API_V1_STR=/api/v1
RATE_LIMIT_PER_MINUTE=300
